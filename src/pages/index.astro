---
import { getCollection } from 'astro:content'
import publishings from '../data/publishings.yaml'
import { Content as Bio } from '../data/bio.md'
import { mergeFeed, type FeedItem } from '../lib/feed'
import '../styles/base.css'

const posts = await getCollection('blog')
const entries = mergeFeed(publishings as FeedItem[], posts)

const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    timeZone: 'UTC',
  })
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Interactive essays and simulation playgrounds on games, data and AI — player lifecycles, virtual economies, live-ops experimentation." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Uğur Koç — interactive essays on games, data & AI" />
    <meta property="og:description" content="Interactive essays and simulation playgrounds on games, data and AI — player lifecycles, virtual economies, live-ops experimentation." />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="https://ugurkc.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Uğur Koç — interactive essays on games, data & AI</title>
    <script data-goatcounter="https://ugurkc.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <main>
      <header class="bio">
        <h1>Uğur Koç</h1>
        <p class="tagline">Data science &amp; AI for games — systems thinking, one lever per essay.</p>
        <div class="bio-text"><Bio /></div>
        <nav class="contact" aria-label="Contact">
          <a href="https://www.linkedin.com/in/ugurkc">LinkedIn</a>
          <a href="https://github.com/ugurkc">GitHub</a>
          <a href="mailto:ugurkoc96@hotmail.com">Email</a>
        </nav>
      </header>

      <section class="publishings" aria-labelledby="publishings-heading">
        <h2 id="publishings-heading">Publishings</h2>
        <ul>
          {
            entries.map((p) => (
              <li>
                <a href={p.url}>
                  <span class="title">{p.title}</span>
                  <time datetime={p.date}>{formatDate(p.date)}</time>
                  <span class="description">{p.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }

  .bio h1 {
    margin: 0 0 4px;
    font-size: 2.2rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0 0 14px;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--accent);
    letter-spacing: 0.01em;
  }

  .bio-text :global(p) {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .contact {
    margin-top: 16px;
    display: flex;
    gap: 18px;
  }

  .contact a {
    font-size: 0.85rem;
    font-weight: 650;
    text-decoration: none;
    color: var(--muted);
  }

  .contact a:hover,
  .contact a:focus-visible {
    color: var(--accent);
  }

  .publishings {
    margin-top: 56px;
  }

  .publishings h2 {
    margin: 0 0 18px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .publishings ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .publishings a {
    display: block;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .publishings a:hover {
    border-color: var(--accent);
  }

  .publishings a:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .publishings .title {
    font-weight: 650;
    font-size: 1.1rem;
  }

  .publishings time {
    float: right;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .publishings .description {
    display: block;
    margin-top: 6px;
    font-size: 0.95rem;
    color: var(--muted);
  }
</style>
